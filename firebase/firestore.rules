rules_version = '2';

// ECOReward Bin - Firestore Security Rules  (audit C-01, Phase 1)
//
// STATUS: drafted from what the Flutter app, the Next.js admin console and the kiosk actually do, and
// exercised by firebase/tests/rules.test.mjs in the local Firestore emulator.
// NOT DEPLOYED. Compare with the rules currently live in the Firebase console, try the apps against the
// emulator or a test project, and only then deploy (see firebase/README.md).
//
// WHAT THIS CLOSES
//   - A customer promoting themselves to admin (`role` can only be set to 'customer' at sign-up and is
//     immutable for customers afterwards; only an existing admin can change it).
//   - Non-admin writes to rewards (except the "stock - 1" done by a redemption), settings, other users'
//     documents, and redemption status.
//   - Listing / enumerating QR tokens, and forging "scanned by" / "user" ids on logs, history, redemptions.
//   - Setting points to an arbitrary number in one write (max +100 per write, never negative).
//
// WHAT THIS CANNOT CLOSE  (needs a trusted code path: audit C-01 step 3)
//   - The phone credits points itself, so a customer can still raise their OWN `points` in small steps.
//     Rules can bound a write, they cannot verify that a QR was genuine.
//
// FIXED (audit H-13, Phases 3 + 5)
//   - Public stats live in `profiles` (username, points, lifetimePoints, badges), which must always be an
//     exact copy of the owner's `users` document. Customers can no longer read each other's `users`
//     documents, so e-mail addresses are private.
//
// Phase 5: `lifetimePoints` (never decreases, +100 max per write); one token = one claim (`isUsed`).
//
// Phase 7 (audit C-02): the kiosk signs in as its own Firebase Auth user with the custom claim
// `kiosk: true` (tools/set_claims.py) instead of using a full-access service-account key. That identity
// can ONLY create well-formed QR tokens, read a token by id, write its own heartbeat and detection log.
// It cannot read users, profiles, logs or redemptions and cannot act as a customer. Admins may also be
// identified by the custom claim `admin: true`; the `users.role == 'admin'` check still works.
// The legacy Admin-SDK kiosk mode bypasses these rules - retire it once the kiosk identity is in use.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ──────────────────────────────────────────────────────────────
    // The kiosk device identity (custom claim set only by tools/set_claims.py with the Admin SDK).
    function isKiosk()      { return request.auth != null && request.auth.token.get('kiosk', false) == true; }
    // A signed-in PERSON (customer or admin). The kiosk is excluded on purpose, so a stolen kiosk
    // credential cannot sign up as a customer, claim tokens or earn points.
    function signedIn()     { return request.auth != null && !isKiosk(); }
    function isOwner(uid)   { return signedIn() && request.auth.uid == uid; }
    function changedKeys()  { return request.resource.data.diff(resource.data).affectedKeys(); }

    // Admin = custom claim `admin: true` (no extra read), or a user document whose role is 'admin'.
    // Neither can be self-granted: claims are set only with the Admin SDK and customers cannot change
    // `role` (see /users). Evaluated last in `||` chains so customers don't pay the extra read.
    function isAdmin() {
      return signedIn()
          && (request.auth.token.get('admin', false) == true
              || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
                  && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'));
    }

    // A QR token exactly as the kiosk creates it: unused, a known category, a 4-digit claim code,
    // created now (server time) and expiring within 30 minutes.
    function isNewKioskToken() {
      let t = request.resource.data;
      return t.keys().hasOnly(['wasteType', 'expiresAt', 'usedBy', 'isUsed', 'createdAt', 'claimCode'])
          && t.wasteType in ['Biodegradable', 'Recyclable', 'Residual']
          && t.usedBy == []
          && t.isUsed == false
          && t.createdAt == request.time
          && t.expiresAt is timestamp
          && t.expiresAt > request.time
          && t.expiresAt <= request.time + duration.value(30, 'm')
          && t.claimCode is string
          && t.claimCode.matches('^[0-9]{4}$');
    }

    // A customer's own balance: an integer, never negative, at most +100 per write.
    function pointsOk() {
      return request.resource.data.points is int
          && request.resource.data.points >= 0
          && request.resource.data.points <= resource.data.points + 100;
    }

    // Points ever earned: missing on older documents (then it equals `points`), never decreases,
    // at most +100 per write - redemptions lower `points` only.
    function lifetimeOk() {
      let before = resource.data.get('lifetimePoints', resource.data.points);
      let after  = request.resource.data.get('lifetimePoints', before);
      return after is int && after >= before && after <= before + 100;
    }

    // ── users ────────────────────────────────────────────────────────────────
    // Private: e-mail and role. The leaderboard reads /profiles instead (audit H-13).
    match /users/{uid} {
      allow get:  if isOwner(uid) || isAdmin();
      allow list: if isAdmin();

      // Sign-up: own document, role 'customer', zeroed stats (the app writes exactly these).
      allow create: if isOwner(uid)
                    && request.resource.data.role == 'customer'
                    && request.resource.data.points == 0
                    && request.resource.data.get('lifetimePoints', 0) == 0
                    && request.resource.data.scanCount == 0
                    && request.resource.data.streak == 0
                    && request.resource.data.badges.size() == 0;

      // The app updates these on a customer's own document: username (profile), and
      // points / lifetimePoints / scanCount / streak / lastScanDate / badges (scan + redeem transactions).
      // `createdAt` is tolerated only for app versions that still send the whole document (audit H-01).
      // `role` and `email` are NOT in the list, so they can never change.
      allow update: if (isOwner(uid)
                        && changedKeys().hasOnly(['username', 'points', 'lifetimePoints', 'scanCount', 'streak',
                                                  'lastScanDate', 'badges', 'createdAt'])
                        && pointsOk()
                        && lifetimeOk())
                    || isAdmin();

      allow delete: if false;
    }

    // ── profiles (public leaderboard stats) ──────────────────────────────────
    // Readable by every signed-in user. A customer may only write an exact copy of their own
    // /users document AS IT WILL BE after the same transaction/batch (getAfter), so a profile can
    // never show more than the bounded, rule-checked user document.
    function mirrorsOwnUser(uid) {
      let u = getAfter(/databases/$(database)/documents/users/$(uid)).data;
      let p = request.resource.data;
      return p.keys().hasOnly(['username', 'points', 'lifetimePoints', 'badges'])
          && p.username == u.username
          && p.points == u.points
          && p.lifetimePoints == u.get('lifetimePoints', u.points)
          && p.badges == u.badges;
    }

    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if (isOwner(uid) && mirrorsOwnUser(uid)) || isAdmin();
      allow delete: if false;
    }

    // ── rewards ──────────────────────────────────────────────────────────────
    match /rewards/{id} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();

      // A redemption lowers a limited stock by exactly 1 (never unlimited = -1, never below 0).
      allow update: if (signedIn()
                        && changedKeys().hasOnly(['stock'])
                        && resource.data.get('stock', -1) is int
                        && resource.data.get('stock', -1) > 0
                        && request.resource.data.stock == resource.data.stock - 1)
                    || isAdmin();
    }

    // ── redemptions ──────────────────────────────────────────────────────────
    match /redemptions/{id} {
      allow read:   if (signedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'pending';
      // Only an admin, and only pending -> claimed.
      allow update: if isAdmin()
                    && changedKeys().hasOnly(['status'])
                    && request.resource.data.status == 'claimed';
      allow delete: if false;
    }

    // ── waste_logs (point-earning ledger) ────────────────────────────────────
    match /waste_logs/{id} {
      allow read:   if (signedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      // `pointsAwarded` (credited, incl. streak bonus) is display data; bound it like a balance change.
      allow create: if (signedIn() && request.resource.data.userId == request.auth.uid
                        && request.resource.data.get('pointsAwarded', 0) is int
                        && request.resource.data.get('pointsAwarded', 0) >= 0
                        && request.resource.data.get('pointsAwarded', 0) <= 100)
                    || isAdmin();
      allow update, delete: if false;
    }

    // ── qr_tokens ────────────────────────────────────────────────────────────
    // Customers can fetch ONE token by id (they hold the QR) but can never list or query tokens.
    match /qr_tokens/{token} {
      allow get:    if signedIn() || isKiosk();      // the kiosk polls its own QR to see it was scanned
      allow list:   if isAdmin();
      allow create: if isAdmin()                     // Flutter admin QR screen
                    || (isKiosk() && isNewKioskToken());

      // One token = one claim (audit H-02): the first customer sets usedBy = [own uid] and isUsed = true.
      // Expiry is checked with server time when expiresAt is a Timestamp (audit H-07).
      allow update: if (signedIn()
                        && changedKeys().hasOnly(['usedBy', 'isUsed'])
                        && resource.data.get('isUsed', false) == false
                        && resource.data.usedBy.size() == 0
                        && request.resource.data.usedBy == [request.auth.uid]
                        && request.resource.data.isUsed == true
                        && (!(resource.data.expiresAt is timestamp) || request.time < resource.data.expiresAt))
                    || isAdmin();
      allow delete: if false;
    }

    // ── qr_scan_history (audit trail written by the phone, read by the web admin) ──
    match /qr_scan_history/{id} {
      allow create: if signedIn() && request.resource.data.scannedByUid == request.auth.uid;
      allow read:   if isAdmin();
      allow update, delete: if false;
    }

    // ── settings / bins ──────────────────────────────────────────────────────
    match /settings/{doc} {
      allow read:  if signedIn();
      allow write: if isAdmin();
    }
    // Fill levels of the kiosk's three compartments, from the ESP32's HC-SR04 sensors (kiosk audit K-05).
    // Only the kiosk identity writes, only its own documents {uid}-bio|rec|res, in the web's BinStatus shape,
    // with server time. Nobody else writes; simulated sorters never send these.
    match /bins/{id} {
      allow read:  if isAdmin();
      allow create, update: if isKiosk()
                    && id in [request.auth.uid + '-bio', request.auth.uid + '-rec', request.auth.uid + '-res']
                    && request.resource.data.keys().hasOnly(['location', 'fillLevel', 'status', 'lastUpdated'])
                    && request.resource.data.fillLevel is int
                    && request.resource.data.fillLevel >= 0 && request.resource.data.fillLevel <= 100
                    && request.resource.data.status in ['online', 'offline']
                    && request.resource.data.location is string && request.resource.data.location.size() <= 80
                    && request.resource.data.lastUpdated == request.time;
      allow delete: if false;
    }

    // ── kiosks (heartbeat) ───────────────────────────────────────────────────
    // A kiosk writes only its OWN document (id = its Auth uid), with a server-time lastSeen.
    match /kiosks/{kioskId} {
      allow read:  if isAdmin();
      allow create, update: if isKiosk()
                    && request.auth.uid == kioskId
                    && request.resource.data.keys().hasOnly(['lastSeen', 'status', 'name'])
                    && request.resource.data.lastSeen == request.time;
      allow delete: if false;
    }

    // ── detections (one row per issued QR, audit M-21) ───────────────────────
    match /detections/{id} {
      allow read:  if isAdmin();
      allow create: if isKiosk()
                    && request.resource.data.keys().hasOnly(['wasteType', 'label', 'confidence', 'modelFile',
                                                             'modelSha256', 'timestamp', 'token', 'kioskId'])
                    && request.resource.data.kioskId == request.auth.uid
                    && request.resource.data.timestamp == request.time
                    && request.resource.data.wasteType in ['Biodegradable', 'Recyclable', 'Residual']
                    && request.resource.data.confidence is number
                    && request.resource.data.confidence >= 0 && request.resource.data.confidence <= 1;
      allow update, delete: if false;
    }

    // Everything else is denied by default.
  }
}
