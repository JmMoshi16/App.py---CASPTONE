rules_version = '2';

// ECOReward Bin - Firestore Security Rules  (audit C-01, Phase 1)
//
// STATUS: drafted from what the Flutter app, the Next.js admin console and the kiosk actually do, and
// exercised by firebase/tests/rules.test.mjs in the local Firestore emulator.
// NOT DEPLOYED. Compare with the rules currently live in the Firebase console, try the apps against the
// emulator or a test project, and only then deploy (see firebase/README.md).
//
// WHAT THIS CLOSES
//   - A customer promoting themselves to admin (`role` can only be set to 'customer' at sign-up and is
//     immutable for customers afterwards; only an existing admin can change it).
//   - Non-admin writes to rewards (except the "stock - 1" done by a redemption), settings, other users'
//     documents, and redemption status.
//   - Listing / enumerating QR tokens, and forging "scanned by" / "user" ids on logs, history, redemptions.
//   - Setting points to an arbitrary number in one write (max +100 per write, never negative).
//
// WHAT THIS CANNOT CLOSE  (needs a trusted code path: audit C-01 step 3)
//   - The phone credits points itself, so a customer can still raise their OWN `points` in small steps.
//     Rules can bound a write, they cannot verify that a QR was genuine.
//
// FIXED (audit H-13, Phases 3 + 5)
//   - Public stats live in `profiles` (username, points, lifetimePoints, badges), which must always be an
//     exact copy of the owner's `users` document. Customers can no longer read each other's `users`
//     documents, so e-mail addresses are private.
//
// Phase 5: `lifetimePoints` (never decreases, +100 max per write); one token = one claim (`isUsed`).
//
// NOTE: the kiosk (Python, Admin SDK) bypasses these rules entirely - see audit C-02.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ──────────────────────────────────────────────────────────────
    function signedIn()     { return request.auth != null; }
    function isOwner(uid)   { return signedIn() && request.auth.uid == uid; }
    function changedKeys()  { return request.resource.data.diff(resource.data).affectedKeys(); }

    // Admin = a user document whose role is 'admin'. Customers cannot change `role` (see /users),
    // so this cannot be self-granted. Evaluated last in `||` chains so customers don't pay the extra read.
    function isAdmin() {
      return signedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // A customer's own balance: an integer, never negative, at most +100 per write.
    function pointsOk() {
      return request.resource.data.points is int
          && request.resource.data.points >= 0
          && request.resource.data.points <= resource.data.points + 100;
    }

    // Points ever earned: missing on older documents (then it equals `points`), never decreases,
    // at most +100 per write - redemptions lower `points` only.
    function lifetimeOk() {
      let before = resource.data.get('lifetimePoints', resource.data.points);
      let after  = request.resource.data.get('lifetimePoints', before);
      return after is int && after >= before && after <= before + 100;
    }

    // ── users ────────────────────────────────────────────────────────────────
    // Private: e-mail and role. The leaderboard reads /profiles instead (audit H-13).
    match /users/{uid} {
      allow get:  if isOwner(uid) || isAdmin();
      allow list: if isAdmin();

      // Sign-up: own document, role 'customer', zeroed stats (the app writes exactly these).
      allow create: if isOwner(uid)
                    && request.resource.data.role == 'customer'
                    && request.resource.data.points == 0
                    && request.resource.data.get('lifetimePoints', 0) == 0
                    && request.resource.data.scanCount == 0
                    && request.resource.data.streak == 0
                    && request.resource.data.badges.size() == 0;

      // The app updates these on a customer's own document: username (profile), and
      // points / lifetimePoints / scanCount / streak / lastScanDate / badges (scan + redeem transactions).
      // `createdAt` is tolerated only for app versions that still send the whole document (audit H-01).
      // `role` and `email` are NOT in the list, so they can never change.
      allow update: if (isOwner(uid)
                        && changedKeys().hasOnly(['username', 'points', 'lifetimePoints', 'scanCount', 'streak',
                                                  'lastScanDate', 'badges', 'createdAt'])
                        && pointsOk()
                        && lifetimeOk())
                    || isAdmin();

      allow delete: if false;
    }

    // ── profiles (public leaderboard stats) ──────────────────────────────────
    // Readable by every signed-in user. A customer may only write an exact copy of their own
    // /users document AS IT WILL BE after the same transaction/batch (getAfter), so a profile can
    // never show more than the bounded, rule-checked user document.
    function mirrorsOwnUser(uid) {
      let u = getAfter(/databases/$(database)/documents/users/$(uid)).data;
      let p = request.resource.data;
      return p.keys().hasOnly(['username', 'points', 'lifetimePoints', 'badges'])
          && p.username == u.username
          && p.points == u.points
          && p.lifetimePoints == u.get('lifetimePoints', u.points)
          && p.badges == u.badges;
    }

    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if (isOwner(uid) && mirrorsOwnUser(uid)) || isAdmin();
      allow delete: if false;
    }

    // ── rewards ──────────────────────────────────────────────────────────────
    match /rewards/{id} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();

      // A redemption lowers a limited stock by exactly 1 (never unlimited = -1, never below 0).
      allow update: if (signedIn()
                        && changedKeys().hasOnly(['stock'])
                        && resource.data.get('stock', -1) is int
                        && resource.data.get('stock', -1) > 0
                        && request.resource.data.stock == resource.data.stock - 1)
                    || isAdmin();
    }

    // ── redemptions ──────────────────────────────────────────────────────────
    match /redemptions/{id} {
      allow read:   if (signedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'pending';
      // Only an admin, and only pending -> claimed.
      allow update: if isAdmin()
                    && changedKeys().hasOnly(['status'])
                    && request.resource.data.status == 'claimed';
      allow delete: if false;
    }

    // ── waste_logs (point-earning ledger) ────────────────────────────────────
    match /waste_logs/{id} {
      allow read:   if (signedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      // `pointsAwarded` (credited, incl. streak bonus) is display data; bound it like a balance change.
      allow create: if (signedIn() && request.resource.data.userId == request.auth.uid
                        && request.resource.data.get('pointsAwarded', 0) is int
                        && request.resource.data.get('pointsAwarded', 0) >= 0
                        && request.resource.data.get('pointsAwarded', 0) <= 100)
                    || isAdmin();
      allow update, delete: if false;
    }

    // ── qr_tokens ────────────────────────────────────────────────────────────
    // Customers can fetch ONE token by id (they hold the QR) but can never list or query tokens.
    match /qr_tokens/{token} {
      allow get:    if signedIn();
      allow list:   if isAdmin();
      allow create: if isAdmin();      // Flutter admin QR screen. The kiosk uses the Admin SDK.

      // One token = one claim (audit H-02): the first customer sets usedBy = [own uid] and isUsed = true.
      // Expiry is checked with server time when expiresAt is a Timestamp (audit H-07).
      allow update: if (signedIn()
                        && changedKeys().hasOnly(['usedBy', 'isUsed'])
                        && resource.data.get('isUsed', false) == false
                        && resource.data.usedBy.size() == 0
                        && request.resource.data.usedBy == [request.auth.uid]
                        && request.resource.data.isUsed == true
                        && (!(resource.data.expiresAt is timestamp) || request.time < resource.data.expiresAt))
                    || isAdmin();
      allow delete: if false;
    }

    // ── qr_scan_history (audit trail written by the phone, read by the web admin) ──
    match /qr_scan_history/{id} {
      allow create: if signedIn() && request.resource.data.scannedByUid == request.auth.uid;
      allow read:   if isAdmin();
      allow update, delete: if false;
    }

    // ── settings / bins ──────────────────────────────────────────────────────
    match /settings/{doc} {
      allow read:  if signedIn();
      allow write: if isAdmin();
    }
    match /bins/{id} {
      allow read:  if isAdmin();
      allow write: if false;           // nothing in the project writes bins (audit H-09)
    }

    // ── kiosks (3.4: heartbeat written by kiosk via Admin SDK) ───────────────
    // The kiosk writes via Admin SDK (bypasses rules). The web admin reads; clients never write.
    match /kiosks/{kioskId} {
      allow read:  if isAdmin();
      allow write: if false;           // Admin SDK only
    }

    // ── detections (3.4: detection log written by kiosk via Admin SDK) ────────
    // Written by the kiosk's Admin SDK. The web admin reads; clients never write.
    match /detections/{id} {
      allow read:  if isAdmin();
      allow write: if false;           // Admin SDK only
    }

    // Everything else is denied by default.
  }
}
